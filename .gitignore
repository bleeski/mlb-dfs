runs/
outputs/
data/standings/inbox/
__pycache__/
*.pyc
.env
.DS_Store

# transient per-slate working inputs (bundle, salaries, entries); the
# durable record is data/archive/<date>/, not data/slates/
data/slates/*/

# stray root-level bundle (belongs in data/slates/<date>/)
/slate_bundle.json

# ad-hoc session scratch
_scratch_*/

# generate-lineups iteration scratch (build scripts, review HTML)
skills/generate-lineups-workspace/

# stray loose feed/bundle files at the slates root (per-slate dirs are ignored
# above). Both shapes appear: an underscore-prefixed scratch name and a
# date-prefixed raw feed dump, e.g. 2026-07-27_lineups_feed_raw.json.
data/slates/*.json

# stray root-level DK downloads. The authoritative copies live in
# data/slates/<date>/ during a build and data/archive/<date>/ after it; a root
# copy is a leftover and is never what a build reads.
/DKEntries.csv
/DKSalaries.csv
/DKEntries*.csv
/DKSalaries*.csv

# audit stdout capture
/audit_out.log
audit_out.log
# Every session that redirects an audit picks its own name; the two above only
# covered one. A stray audit log in the repo root reads as foreign dirt at the
# next session's start and costs someone a paragraph deciding whose it is.
_audit.log
*_audit.log
audit*.log

# zero-byte DK exports quarantined by the pull step; they are failed pulls, not
# evidence, and the contest stays on the awaiting list until a real pull lands
data/standings/failed_pulls/

# superseded worklists the sandbox could not delete; status lives in
# CONTESTS_AWAITING_STANDINGS.md, which is tracked
data/standings/PENDING_MINE_*.md

# vendored interpreter state: a local scipy install and its wheel cache, plus the
# scratch dir. Environment, never history. `export PYTHONPATH=$PWD/.pylibs` is what
# makes scipy.optimize.milp importable without a network install (2026-08-03).
.pylibs/
.wheels/
.tmp/

# raw DK zips whose CSV is already mined into data/archive/. The extracted CSV is
# the durable record and it is tracked; the zip is the same bytes a second time.
# Moved here rather than deleted because the sandbox cannot delete (2026-08-03).
data/standings/processed_zips/

# files a session finished with and could not delete: the sandbox denies rm on the
# mount. Ben empties this folder; nothing here is history and nothing reads it.
_to_delete/

# multi-session claims: live state, never history (keep the dir itself)
claims/*
!claims/.gitkeep

# BUILD byproduct cache (lineups_from_paste); untracked by design (R-merge 2026-08-04)
data/reference/paste_cache/

# residue of the disk-to-container tarball bridge in docs/cowork_sync_protocol.md.
# Environment, never history; the mount cannot delete it, so it is ignored instead
# of swept, and it stops reading as unexplained dirt at session start (R107(b)).
_stage_repo*.tar.gz

# R152 split-gate state: per-class results for a gate run across several calls.
# Live session state, never history -- the verdict is the audit's output, and a
# unit record is only evidence about the tree fingerprint stamped on it.
.audit_gate/
